# Copy to .env and edit. Never commit the real .env.
NODE_ENV=development
PORT=4000
ML_URL=http://127.0.0.1:5001
ML_API_KEY=dev-ml-key-change-me
# Required in production (use a long random string): JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Logging: debug | info | summary | error  (default debug)
LOG_LEVEL=debug
